# Copy to .env (git-ignored). Every value is optional: the platform runs without any of them.

# ── Neo4j (optional graph database; `docker compose up -d neo4j` uses the same password) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please

# ── Offline GeoIP databases (default: first .mmdb found in data/geoip/) ──
# GEOIP_COUNTRY_DB=data/geoip/dbip-country-lite.mmdb
# GEOIP_ASN_DB=data/geoip/dbip-asn-lite.mmdb

# ── Storage ──
# Where uploads, analysis snapshots and per-dataset outputs are kept.
# DATASET_STORE_DIR=data/raw/uploads
# Built dashboard served at / (default: frontend/dist).
# FRONTEND_DIST=frontend/dist

# ── Network interpretation ──
# Ports a Bitcoin node normally listens on; anything else counts as non-standard.
# BITCOIN_STANDARD_PORTS=8333
