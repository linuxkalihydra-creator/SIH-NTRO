# Python caches and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
wheels/
/dist/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/

# Node dependencies and logs. The built dashboard (frontend/dist) IS committed:
# FastAPI serves it, so an offline deployment needs no Node.js.
node_modules/
dist-ssr/
*.log

# Environment files: commit only the .env.example templates
.env
.env.*
!.env.example

# Runtime data written by the app and pipeline (uploads, snapshots, analysis output)
data/raw/uploads/
data/processed/

# Local GeoIP databases (downloaded by scripts/download_geoip.py; MaxMind's licence forbids redistribution)
data/geoip/*.mmdb

# Air-gap bundle build output
offline-bundle/
wheelhouse/
.deps/

# Editors and IDEs
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Local AI coding-agent state and worktrees
.kilo/
.kilocode/

# Damaged copy of an old .git directory; kept on disk pending review (holds
# agent checkpoint objects found nowhere else). Remove this entry once deleted.
.git-corrupted/
