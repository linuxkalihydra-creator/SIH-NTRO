# Both settings are optional. With neither, the dashboard talks to `/api` on its own
# origin: the backend serves the built dashboard, and `npm run dev` proxies `/api`.

# Where the dashboard sends API requests. Set it only when the backend runs on
# another origin, e.g. http://127.0.0.1:8000 (its routes are served at the root too).
# VITE_API_URL=http://127.0.0.1:8000

# Where the `npm run dev` proxy forwards `/api` (default http://127.0.0.1:8000).
# VITE_BACKEND_URL=http://127.0.0.1:8000
